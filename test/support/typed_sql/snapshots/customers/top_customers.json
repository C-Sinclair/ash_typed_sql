  ],
  "sql": "select c.id, c.name, c.email, c.tier, c.tags, sum(o.total) as lifetime_value\nfrom customers c\njoin orders o on o.customer_id = c.id\nwhere o.inserted_at > $1\ngroup by c.id\norder by lifetime_value desc\nlimit $2\n",
